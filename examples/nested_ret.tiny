// Nested if/else with early returns; function call used in a condition.
fn classify(n: int) -> int {
    if is_neg(n) {
        return -1;
    } else {
        if n == 0 {
            return 0;
        } else {
            if n < 10 {
                return 1;
            } else {
                return 2;
            }
        }
    }
}

fn is_neg(n: int) -> bool {
    return n < 0;
}

print(classify(-3));
print(classify(0));
print(classify(7));
print(classify(42));
