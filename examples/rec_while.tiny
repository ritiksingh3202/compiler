// Recursion + while: sum digits of fib(n) via a loop inside the recursive call path.
fn digit_sum(n: int) -> int {
    let total = 0;
    while n > 0 {
        total = total + (n % 10);
        n = n / 10;
    }
    return total;
}

fn walk(n: int) -> int {
    if n <= 0 {
        return 0;
    }
    // Recurse, then fold the result with a while-based digit sum.
    let prev = walk(n - 1);
    return prev + digit_sum(n);
}

print(walk(5));
