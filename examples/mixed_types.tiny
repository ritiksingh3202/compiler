// All three types together: strings, bools, ints, arithmetic, comparisons, print.
fn label(score: int) -> string {
    if score >= 90 {
        return "A";
    } else {
        if score >= 70 {
            return "B";
        } else {
            return "C";
        }
    }
}

let name = "tiny";
let score = 10 * 8 + 5;
let pass = score >= 70;
print(name);
print(score);
print(pass);
print(label(score));
print(label(50));
